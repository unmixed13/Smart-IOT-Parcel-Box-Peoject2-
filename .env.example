# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Shared secret ESP32 devices send in the X-API-Key header. Generate a real
# random value before exposing this server (e.g. `openssl rand -hex 32`).
HARDWARE_API_KEY=change_me
# Comma-separated list of allowed dashboard origins.
CORS_ORIGINS=http://localhost:3000
# Shared secret for the dashboard WebSocket (?token=). Leave blank only for
# local dev - the dashboard feed is unauthenticated if this is unset.
DASHBOARD_TOKEN=

# --- Database ---
# SQLite for zero-setup local dev:
DATABASE_URL=sqlite+aiosqlite:///./parcel_box.db
# MySQL for production:
# DATABASE_URL=mysql+aiomysql://parcelbox:parcelbox@localhost:3306/parcel_box?charset=utf8mb4

# --- MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
# Public HTTPS base URL for this server (ngrok/Cloudflare Tunnel in dev).
PUBLIC_BASE_URL=

# --- File storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=8
