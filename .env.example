# Admin key for /api/admin/* and /api/hardware/* (devices get their own keys)
HARDWARE_API_KEY=change-me-long-random
DASHBOARD_TOKEN=change-me
DATABASE_URL=mysql+aiomysql://parcelbox:CHANGE_ME@localhost:3306/parcel_box?charset=utf8mb4
ENVIRONMENT=production
DEBUG=false

# LINE Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_USER_ID=            # admin's own userId: receives denied-scan alerts
# LINE Login channel that owns the LIFF app
LIFF_CHANNEL_ID=
LIFF_ID=

# Public HTTPS URL (Tailscale Funnel) so LINE can fetch /media/* images
PUBLIC_BASE_URL=

MQTT_HOST=localhost
